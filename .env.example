# ── Banco de dados ───────────────────────────────────────────────────────────
# Desenvolvimento local (Postgres via Homebrew):
#   DATABASE_URL="postgresql://SEU_USUARIO@localhost:5432/cardgame?schema=public"
#
# Produção (Supabase → Project Settings → Database → Connection string):
#   Use a URI do "Connection pooling" (porta 6543) e acrescente ?pgbouncer=true
#   DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
DATABASE_URL=

# Só é necessária no Supabase/serverless: as migrations do Prisma precisam de
# uma conexão direta, sem o pooler.
DIRECT_URL=
