generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // O Supabase serve a app pelo pooler (pgbouncer), mas as migrations exigem
  // conexao direta. Em dev local as duas apontam pro mesmo Postgres.
  directUrl = env("DIRECT_URL")
}

model Game {
  id           String       @id @default(uuid())
  code         String       @unique
  createdAt    DateTime     @default(now())
  status       GameStatus   @default(LOBBY)
  /// Como a partida acaba. As duas condicoes sao exclusivas de proposito:
  /// juntas elas se contradizem quando uma dispara antes da outra.
  endCondition EndCondition @default(TARGET_SCORE)
  /// Pontos para vencer. Usado quando endCondition = TARGET_SCORE.
  targetScore  Int          @default(5)
  /// Rodadas da partida. Usado quando endCondition = ROUND_LIMIT.
  roundLimit   Int          @default(8)
  /// Como a mao e reabastecida entre rodadas.
  deckMode     DeckMode     @default(DEPLETE)
  /// Cartas na mao. Em DEPLETE, define quantas rodadas a partida aguenta.
  handSize     Int          @default(7)
  /// A cada quantas rodadas entra uma rodada de som. 0 desliga.
  soundEvery   Int          @default(0)
  /// A cada quantas rodadas entra uma rodada de imagem. 0 desliga.
  imageEvery   Int          @default(0)
  /// Segundos para cada fase da rodada. 0 desliga o prazo.
  turnSeconds  Int          @default(60)
  /// Cartas-pergunta ainda nao usadas, embaralhadas no inicio da partida.
  promptDeck   String[]
  /// Cartas-resposta ainda nao distribuidas.
  answerDeck   String[]
  players      Player[]
  rounds       Round[]
}

model Player {
  id          String       @id @default(uuid())
  name        String
  gameId      String
  isHost      Boolean      @default(false)
  score       Int          @default(0)
  /// Mao do jogador: cartas-resposta que ele pode jogar.
  hand        String[]
  /// Ids de SoundCard na mao de som. Sorteada a cada rodada de som.
  soundHand   String[]
  /// Ids de ImageCard na mao de imagem. Sorteada a cada rodada de imagem.
  imageHand   String[]
  joinedAt    DateTime     @default(now())
  /// Quando abandonou a partida em andamento. Null = ainda na mesa.
  ///
  /// A linha fica, em vez de ser apagada, porque as jogadas e os votos dele
  /// continuam valendo nas rodadas ja disputadas — e porque a mesa merece ver
  /// quem quitou. Quem sai do lobby e apagado de verdade: nao havia partida.
  leftAt      DateTime?
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  submissions Submission[]
  votes       Vote[]

  @@unique([gameId, name])
}

model Round {
  id          String       @id @default(uuid())
  gameId      String
  number      Int
  prompt      String
  /// Rodada de texto ou de som. Define de que baralho a mao e jogada.
  kind        RoundKind    @default(TEXT)
  phase       RoundPhase   @default(SUBMITTING)
  /// Quando a fase atual vence. Renovado a cada troca de fase; nulo quando o
  /// prazo esta desligado. Fica no banco, e nao no navegador, para quem fechou
  /// a aba nao travar a rodada dos outros.
  deadline    DateTime?
  winnerId    String?
  createdAt   DateTime     @default(now())
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  submissions Submission[]
  votes       Vote[]

  @@unique([gameId, number])
}

model Submission {
  id          String     @id @default(uuid())
  roundId     String
  playerId    String
  /// Texto da carta jogada. Em rodada de som guarda o nome, para o historico
  /// sobreviver a exclusao do arquivo.
  card        String
  /// Preenchido apenas em rodada de som.
  soundCardId String?
  /// Preenchido apenas em rodada de imagem.
  imageCardId String?
  round       Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player      Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sound       SoundCard? @relation(fields: [soundCardId], references: [id], onDelete: SetNull)
  image       ImageCard? @relation(fields: [imageCardId], references: [id], onDelete: SetNull)
  votes       Vote[]

  /// Um jogador joga no maximo uma carta por rodada.
  @@unique([roundId, playerId])
}

model Vote {
  id           String     @id @default(uuid())
  roundId      String
  voterId      String
  submissionId String
  round        Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter        Player     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Um voto por jogador por rodada.
  @@unique([roundId, voterId])
}

/// Biblioteca de sons. O arquivo vive no bucket "sounds" do Supabase Storage;
/// aqui fica so o caminho e o que a interface precisa saber antes de tocar.
model SoundCard {
  id          String       @id @default(uuid())
  /// Caminho do objeto dentro do bucket.
  path        String       @unique
  /// Nome mostrado na carta.
  name        String
  /// Duracao, para a carta dizer quanto dura antes de alguem tocar.
  durationMs  Int          @default(0)
  /// Ganho de reproducao. Os arquivos variam muito de volume entre si.
  gain        Float        @default(1)
  /// Permite tirar um som de circulacao sem apagar o historico.
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

/// Biblioteca de imagens. Espelha SoundCard de proposito, em vez de as duas
/// virarem uma tabela so com um campo `kind`: unificar exigiria migrar a chave
/// estrangeira que as submissoes ja gravadas usam, e o ganho seria umas poucas
/// linhas de codigo parecido. Duplicar aqui nao arrisca o que ja esta no ar.
model ImageCard {
  id          String       @id @default(uuid())
  /// Caminho do objeto dentro do bucket "images".
  path        String       @unique
  /// Nome mostrado como legenda e usado no historico.
  name        String
  /// Proporcao do arquivo, para a carta reservar o espaco certo antes de
  /// carregar e a grade nao pular quando as imagens chegam.
  width       Int          @default(0)
  height      Int          @default(0)
  /// Permite tirar uma imagem de circulacao sem apagar o historico.
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

enum RoundKind {
  TEXT
  SOUND
  IMAGE
}

enum EndCondition {
  /// Vence quem chegar primeiro a targetScore.
  TARGET_SCORE
  /// Acaba na rodada roundLimit; vence o maior placar.
  ROUND_LIMIT
}

enum DeckMode {
  /// Legado. Joga uma carta, compra uma — a mao mudava tao pouco que a partida
  /// parecia estatica, e por isso saiu da tela. Permanece no enum porque
  /// partidas antigas gravaram este valor e removê-lo as tornaria ilegiveis.
  REFILL
  /// Mao inteira nova, sorteada a cada rodada.
  FRESH
  /// Mao inicial que so diminui. Acabar as cartas encerra a partida.
  DEPLETE
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
  /// O host saiu antes do fim. Diferente de FINISHED porque nao ha campeao:
  /// a partida nao chegou ao fim, foi interrompida.
  ABANDONED
}

enum RoundPhase {
  SUBMITTING
  VOTING
  REVEAL
}
