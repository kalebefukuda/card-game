generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // O Supabase serve a app pelo pooler (pgbouncer), mas as migrations exigem
  // conexao direta. Em dev local as duas apontam pro mesmo Postgres.
  directUrl = env("DIRECT_URL")
}

model Game {
  id          String     @id @default(uuid())
  code        String     @unique
  createdAt   DateTime   @default(now())
  status      GameStatus @default(LOBBY)
  /// Pontos necessarios para vencer a partida.
  targetScore Int        @default(5)
  /// Cartas-pergunta ainda nao usadas, embaralhadas no inicio da partida.
  promptDeck  String[]
  /// Cartas-resposta ainda nao distribuidas.
  answerDeck  String[]
  players     Player[]
  rounds      Round[]
}

model Player {
  id          String       @id @default(uuid())
  name        String
  gameId      String
  isHost      Boolean      @default(false)
  score       Int          @default(0)
  /// Mao do jogador: cartas-resposta que ele pode jogar.
  hand        String[]
  joinedAt    DateTime     @default(now())
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  submissions Submission[]
  votes       Vote[]

  @@unique([gameId, name])
}

model Round {
  id          String       @id @default(uuid())
  gameId      String
  number      Int
  prompt      String
  phase       RoundPhase   @default(SUBMITTING)
  winnerId    String?
  createdAt   DateTime     @default(now())
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  submissions Submission[]
  votes       Vote[]

  @@unique([gameId, number])
}

model Submission {
  id       String @id @default(uuid())
  roundId  String
  playerId String
  card     String
  round    Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  votes    Vote[]

  /// Um jogador joga no maximo uma carta por rodada.
  @@unique([roundId, playerId])
}

model Vote {
  id           String     @id @default(uuid())
  roundId      String
  voterId      String
  submissionId String
  round        Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter        Player     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Um voto por jogador por rodada.
  @@unique([roundId, voterId])
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

enum RoundPhase {
  SUBMITTING
  VOTING
  REVEAL
}
